{
  "manifest_version": 3,
  "name": "Comics Importer",
  "version": "0.3.0",
  "description": "Import avancé MyReadingManga vers Google Drive et le catalogue Comics, avec détection robuste, stabilisation du chargement et diagnostics.",
  "permissions": ["storage", "tabs", "scripting", "identity", "notifications"],
  "host_permissions": [
    "https://myreadingmanga.info/*",
    "https://*.myreadingmanga.info/*",
    "https://www.googleapis.com/*",
    "https://api.github.com/*",
    "https://pharmaexport.github.io/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://pharmaexport.github.io/*"],
      "js": ["content-app.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://myreadingmanga.info/*", "https://*.myreadingmanga.info/*"],
      "js": ["content-mrm.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Comics Importer"
  }
}
